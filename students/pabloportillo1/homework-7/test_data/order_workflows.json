    {
      "name": "invalid_customer_cannot_order",
      "description": "A customer that fails validation cannot create an order, so there is nothing to total.",
      "gateway": {
        "available_credit": 500
      },
      "steps": [
        {
          "action": "validate_customer",
          "data": {
            "customer": {
              "email": "john.doe@",
              "phone": "(555) 123-4567",
              "billing_address": {
                "street": "123 Main St",
                "city": "New York",
                "state": "NY",
                "zip": "10001"
              },
              "credit_card": {
                "number": "4111111111111111",
                "expiration": "12/2028",
                "cvv": "123"
              }
            }
          },
          "expected": {
            "valid": false,
            "errors": [
              "Invalid email format"
            ]
          }
        },
        {
          "action": "create_order",
          "data": {
            "items": [
              {
                "name": "Notebook",
                "price": 12.5,
                "quantity": 1,
                "weight": 0.3
              }
            ]
          },
          "expected": {
            "status": "rejected",
            "reason": "Customer has not been validated"
          }
        },
        {
          "action": "calculate_total",
          "expected_error": "No order has been created"
        }
      ]
    },
    {
      "name": "declined_payment_flow",
      "description": "The issuer declines a charge above the available credit, so no confirmation is issued.",
      "gateway": {
        "available_credit": 50
      },
      "steps": [
        {
          "action": "validate_customer",
          "data": {
            "customer": {
              "email": "john.doe@example.com",
              "phone": "(555) 123-4567",
              "billing_address": {
                "street": "123 Main St",
                "city": "New York",
                "state": "NY",
                "zip": "10001"
              },
              "credit_card": {
                "number": "4111111111111111",
                "expiration": "12/2028",
                "cvv": "123"
              }
            }
          },
          "expected": {
            "valid": true,
            "errors": []
          }
        },
        {
          "action": "create_order",
          "data": {
            "items": [
              {
                "name": "Rug",
                "price": 120.0,
                "quantity": 1,
                "weight": 12
              }
            ],
            "discount_code": "FREESHIP",
            "distance_km": 200
          },
          "expected": {
            "status": "created",
            "discount_applied": true
          }
        },
        {
          "action": "calculate_total",
          "expected": {
            "subtotal": 120.0,
            "discount": 0.0,
            "tax": 9.6,
            "shipping": 0.0,
            "total": 129.6
          }
        },
        {
          "action": "process_payment",
          "expected": {
            "status": "declined",
            "reason": "Payment declined by the card issuer"
          }
        },
        {
          "action": "generate_confirmation",
          "expected_error": "Order has not been paid"
        }
      ]
    },
    {
