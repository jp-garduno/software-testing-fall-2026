    },
    {
      "name": "rejected_order_is_corrected",
      "description": "Invalid orders are rejected without failing the checkout; the corrected order goes through.",
      "gateway": {
        "available_credit": 100
      },
      "steps": [
        {
          "action": "validate_customer",
          "data": {
            "customer": {
              "email": "john.doe@example.com",
              "phone": "(555) 123-4567",
              "billing_address": {
                "street": "123 Main St",
                "city": "New York",
                "state": "NY",
                "zip": "10001"
              },
              "credit_card": {
                "number": "4111111111111111",
                "expiration": "12/2028",
                "cvv": "123"
              }
            }
          },
          "expected": {
            "valid": true,
            "errors": []
          }
        },
        {
          "action": "create_order",
          "data": {
            "items": [
              {
                "name": "Mug",
                "price": 8.0,
                "quantity": -2,
                "weight": 0.3
              }
            ]
          },
          "expected": {
            "status": "rejected",
            "reason": "Item 'Mug': quantity cannot be negative"
          }
        },
        {
          "action": "create_order",
          "data": {
            "items": [
              {
                "name": "Mug",
                "price": 8.0,
                "quantity": 2,
                "weight": 0.3
              }
            ],
            "distance_km": "far"
          },
          "expected": {
            "status": "rejected",
            "reason": "Distance must be a number"
          }
        },
        {
          "action": "process_payment",
          "expected_error": "No order has been created"
        },
        {
          "action": "create_order",
          "data": {
            "items": [
              {
                "name": "Mug",
                "price": 8.0,
                "quantity": 2,
                "weight": 0.3
              }
            ],
            "discount_code": "SAVE20",
            "distance_km": 10
          },
          "expected": {
            "status": "created",
            "discount_applied": false
          }
        },
        {
          "action": "calculate_total",
          "expected": {
            "subtotal": 16.0,
            "discount": 0.0,
            "tax": 1.28,
            "shipping": 1.3,
            "total": 18.58
          }
        },
        {
          "action": "process_payment",
          "expected": {
            "status": "success",
            "amount": 18.58
          }
        },
        {
          "action": "generate_confirmation",
          "expected": {
            "status": "confirmed",
            "item_count": 2
          }
        }
      ]
    },
