      },
      "steps": [
        {
          "action": "validate_customer",
          "data": {
            "customer": {
              "email": "john.doe@example.com",
              "phone": "(555) 123-4567",
              "billing_address": {
                "street": "123 Main St",
                "city": "New York",
                "state": "NY",
                "zip": "10001"
              },
              "credit_card": {
                "number": "4111111111111111",
                "expiration": "12/2028",
                "cvv": "123"
              }
            }
          },
          "expected": {
            "valid": true,
            "errors": []
          }
        },
        {
          "action": "create_order",
          "data": {
            "items": [
              {
                "name": "Headphones",
                "price": 50.0,
                "quantity": 1,
                "weight": 0
              }
            ],
            "discount_code": "SAVE10"
          },
          "expected": {
            "status": "created",
            "discount_applied": true
          }
        },
        {
          "action": "process_payment",
          "expected": {
            "status": "success",
