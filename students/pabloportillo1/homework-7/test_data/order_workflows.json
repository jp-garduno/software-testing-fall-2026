{
  "reference_date": "2026-11-01",
  "workflows": [
    {
      "name": "complete_order_flow",
      "description": "Regular customer with SAVE10; the card has exactly the order total available.",
      "gateway": {
        "available_credit": 101.55
      },
      "steps": [
        {
          "action": "validate_customer",
          "data": {
            "customer": {
              "email": "john.doe@example.com",
              "phone": "(555) 123-4567",
              "billing_address": {
                "street": "123 Main St",
                "city": "New York",
                "state": "NY",
                "zip": "10001"
              },
              "credit_card": {
                "number": "4111111111111111",
                "expiration": "12/2028",
                "cvv": "123"
              }
            }
          },
          "expected": {
            "valid": true,
            "errors": []
          }
        },
        {
          "action": "create_order",
          "data": {
            "items": [
              {
                "name": "Desk lamp",
                "price": 39.99,
                "quantity": 2,
                "weight": 1.2
              },
              {
                "name": "Light bulb",
                "price": 5.25,
                "quantity": 4,
                "weight": 0.1
              }
            ],
            "discount_code": "SAVE10",
            "distance_km": 20
          },
          "expected": {
            "status": "created",
            "discount_applied": true
          }
        },
        {
          "action": "calculate_total",
          "expected": {
            "subtotal": 100.98,
            "discount": 10.1,
            "tax": 7.27,
            "shipping": 3.4,
            "total": 101.55
          }
        },
        {
          "action": "process_payment",
          "expected": {
            "status": "success",
            "amount": 101.55,
            "transaction_id": "TXN-0001"
          }
        },
        {
          "action": "generate_confirmation",
          "expected": {
            "status": "confirmed",
            "transaction_id": "TXN-0001",
            "email": "john.doe@example.com",
            "item_count": 6,
            "total": 101.55
          }
        }
      ]
    },
