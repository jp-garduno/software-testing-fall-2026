        "cvv": "x"
      }
    },
    "expected": {
      "is_valid": false,
      "errors": [
        "Invalid email format",
        "Invalid phone format",
        "Missing street",
        "Missing city",
        "Invalid state",
        "Invalid zip code",
        "Invalid credit card number",
        "Invalid CVV",
        "Invalid expiration date"
