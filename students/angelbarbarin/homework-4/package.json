{
  "name": "homework-4-securebank",
  "version": "1.0.0",
  "private": true,
  "description": "Suite de pruebas de caja negra para SecureBank (implementación JavaScript del bonus)",
  "scripts": {
    "test": "jest",
    "test:coverage": "jest --coverage --verbose",
    "lint": "eslint ."
  },
  "devDependencies": {
    "eslint": "^8.57.0",
    "jest": "^29.7.0"
  },
  "jest": {
    "testEnvironment": "node",
    "roots": ["<rootDir>/tests"],
    "testMatch": ["**/*.test.js"],
    "collectCoverageFrom": ["src/**/*.js"],
    "coverageThreshold": {
      "global": { "branches": 80, "functions": 80, "lines": 80, "statements": 80 }
    }
  }
}
