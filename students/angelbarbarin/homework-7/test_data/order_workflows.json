{
  "reference_date": "2026-11-01",
  "workflows": [
    {
      "name": "complete_order_flow",
      "description": "Happy path: valid customer, SAVE10, standard shipping, payment and confirmation",
      "steps": [
        {
          "action": "validate_customer",
          "data": {
            "email": "maria@example.com",
            "phone": "(312) 555-0199",
            "billing_address": {
              "street": "742 Evergreen Ter",
              "city": "Chicago",
              "state": "IL",
              "zip": "60614"
            },
            "credit_card": {
              "number": "4532015112830366",
              "expiration": "08/2029",
              "cvv": "321"
            }
          },
          "expected": {
            "valid": true,
            "errors": []
          }
        },
        {
          "action": "create_order",
          "data": {
            "items": [
              {
                "name": "Running Shoes",
                "price": 89.99,
                "quantity": 1,
                "weight": 0.9
              },
              {
                "name": "Socks",
                "price": 6.5,
                "quantity": 3,
                "weight": 0.1
              }
            ],
            "customer_type": "regular"
          },
          "expected": {
            "status": "created",
            "items_count": 2
          }
        },
        {
          "action": "apply_discount",
          "data": {
            "code": "SAVE10"
          },
          "expected": {
            "applied": true,
            "discount_code": "SAVE10"
          }
        },
        {
          "action": "set_shipping",
          "data": {
            "distance_km": 35,
            "is_express": false
          },
          "expected": {
            "status": "ok"
          }
        },
        {
          "action": "calculate_total",
          "expected": {
            "status": "calculated",
            "subtotal": 109.49,
            "discount": 10.95,
            "tax": 7.88,
            "shipping": 8.1,
            "total": 114.52
          }
        },
        {
          "action": "process_payment",
          "expected": {
            "status": "success",
            "amount": 114.52
          }
        },
        {
          "action": "generate_confirmation",
          "expected": {
            "status": "confirmed",
            "email": "maria@example.com",
            "total": 114.52
          }
        }
      ]
    },
