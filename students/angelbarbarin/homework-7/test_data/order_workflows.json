    {
      "name": "invalid_order_data_rejected",
      "description": "Negative quantity and empty carts are rejected; unknown actions report an error",
      "steps": [
        {
          "action": "validate_customer",
          "data": {
            "email": "maria@example.com",
            "phone": "(312) 555-0199",
            "billing_address": {
              "street": "742 Evergreen Ter",
              "city": "Chicago",
              "state": "IL",
              "zip": "60614"
            },
            "credit_card": {
              "number": "4532015112830366",
