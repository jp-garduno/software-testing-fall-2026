      ]
    },
    {
      "name": "invalid_customer_blocks_order",
      "description": "An invalid customer cannot create an order or pay",
      "steps": [
        {
          "action": "validate_customer",
          "data": {
            "email": "maria-at-example.com",
            "phone": "312-555-0199",
            "billing_address": {
              "street": "742 Evergreen Ter",
              "city": "Chicago",
              "state": "IL",
              "zip": "60614"
            },
            "credit_card": {
              "number": "4532015112830366",
              "expiration": "08/2029",
              "cvv": "321"
            }
          },
          "expected": {
            "valid": false,
            "errors": [
              "Invalid email format",
              "Invalid phone format"
            ]
          }
        },
        {
          "action": "create_order",
          "data": {
            "items": [
              {
                "name": "Desk",
                "price": 199,
                "quantity": 1,
                "weight": 18
              }
            ]
          },
          "expected": {
            "status": "rejected",
            "error": "Customer must be validated first"
          }
        },
        {
          "action": "calculate_total",
          "expected": {
            "status": "error",
            "error": "No order to calculate"
          }
        },
        {
          "action": "process_payment",
          "expected": {
            "status": "error",
            "error": "Total must be calculated first"
          }
        },
        {
          "action": "generate_confirmation",
          "expected": {
            "status": "error",
            "error": "Order is not paid"
          }
        }
      ]
    },
    {
      "name": "declined_payment_flow",
      "description": "The gateway declines the card, so no confirmation is generated",
      "gateway": {
