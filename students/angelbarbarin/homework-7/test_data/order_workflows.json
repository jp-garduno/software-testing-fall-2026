        {
          "action": "apply_discount",
          "data": {
            "code": "SAVE10"
          },
          "expected": {
            "status": "error",
            "error": "No order to discount"
          }
        },
        {
          "action": "set_shipping",
          "data": {
            "distance_km": 5
