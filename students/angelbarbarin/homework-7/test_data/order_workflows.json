              "cvv": "321"
            }
          },
          "expected": {
            "valid": true
          }
        },
        {
          "action": "create_order",
          "data": {
            "items": [
              {
                "name": "Pen",
                "price": 1.5,
                "quantity": -1,
                "weight": 0.01
              }
            ]
          },
          "expected": {
