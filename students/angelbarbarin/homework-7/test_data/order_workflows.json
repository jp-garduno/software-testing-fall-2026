              "cvv": "321"
            }
          },
          "expected": {
            "valid": true
          }
        },
        {
          "action": "create_order",
          "data": {
            "items": [
              {
                "name": "Smart Watch",
                "price": 249,
                "quantity": 1,
                "weight": 0.3
              }
            ]
          },
          "expected": {
            "status": "created"
          }
        },
        {
          "action": "apply_discount",
          "data": {
            "code": "SAVE20"
          },
          "expected": {
            "applied": true
          }
        },
        {
          "action": "set_shipping",
          "data": {
            "distance_km": 60
          },
          "expected": {
            "status": "ok"
          }
        },
        {
          "action": "calculate_total",
          "expected": {
            "status": "calculated",
            "subtotal": 249.0,
            "discount": 49.8,
            "tax": 15.94,
            "shipping": 10.15,
            "total": 225.29
          }
        },
        {
          "action": "process_payment",
          "expected": {
            "status": "declined",
            "error": "Card declined"
          }
        },
        {
          "action": "generate_confirmation",
          "expected": {
            "status": "error",
            "error": "Order is not paid"
          }
        }
      ]
    },
    {
      "name": "discount_retry_and_step_order",
