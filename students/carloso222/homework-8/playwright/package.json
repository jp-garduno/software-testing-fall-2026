{
  "name": "homework-8-playwright",
  "version": "1.0.0",
  "private": true,
  "description": "Homework 8 - Playwright E2E tests for TodoMVC React (carloso222)",
  "scripts": {
    "test": "playwright test --project=chromium",
    "test:headed": "playwright test --project=chromium --headed",
    "test:cross-browser": "playwright test --project=chromium --project=firefox --project=webkit --workers=4",
    "test:perf": "playwright test --project=perf",
    "report": "playwright show-report"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1"
  }
}
