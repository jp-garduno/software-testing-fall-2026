{
  "reference_date": "2026-01-15",
  "workflows": [
    {
      "name": "complete_order_flow",
      "description": "Valid customer, SAVE10, standard shipping, payment succeeds",
      "steps": [
        {
          "action": "validate_customer",
          "data": {
            "email": "john@example.com",
            "phone": "(555) 123-4567",
            "billing_address": {
              "street": "123 Main St",
              "city": "New York",
              "state": "NY",
              "zip": "10001"
            },
            "credit_card": {
              "number": "4532015112830366",
              "expiration": "12/2030",
              "cvv": "123"
            }
          },
          "expected": {
            "valid": true,
            "errors": []
          }
        },
        {
          "action": "create_order",
          "data": {
            "items": [
              {
                "name": "Widget",
                "price": 40,
                "quantity": 2,
                "weight": 1
              }
            ],
            "customer_type": "regular",
            "discount_code": "SAVE10",
            "distance_km": 10,
            "is_express": false
          },
          "expected": {
            "status": "created"
          }
        },
        {
          "action": "calculate_total",
          "expected": {
            "subtotal": 80.0,
            "discount": 8.0,
            "tax": 5.76,
            "shipping": 2.0,
            "total": 79.76
          }
        },
        {
          "action": "process_payment",
          "expected": {
            "status": "success",
            "amount": 79.76
          }
        }
      ]
    },
