{
  "workflows": [
    {
      "name": "complete_standard_order_flow",
      "description": "Happy path: valid customer, regular order with SAVE10, standard shipping and payment",
      "steps": [
        {
          "step_number": 1,
          "action": "validate_customer",
          "data": {
            "email": "customer@example.com",
            "phone": "(555) 234-5678",
            "billing_address": {
              "street": "100 Broadway",
              "city": "New York",
              "state": "NY",
              "zip": "10005"
            },
            "credit_card": {
              "number": "4532015112830366",
              "expiration": "12/2028",
              "cvv": "123"
            }
          },
          "expected": {
            "is_valid": true,
            "errors": []
          }
        },
        {
          "step_number": 2,
          "action": "create_order",
          "data": {
            "items": [
              {"name": "Desk Lamp", "price": 40.00, "quantity": 2, "weight": 1.50}
            ],
            "customer_type": "regular"
          },
          "expected": {
            "status": "created",
            "subtotal": 80.00
          }
        },
        {
          "step_number": 3,
          "action": "apply_discount",
          "data": {
            "code": "SAVE10"
          },
          "expected": {
            "applied": true,
            "discount_amount": 8.00
          }
        },
        {
          "step_number": 4,
          "action": "set_shipping",
          "data": {
            "distance_km": 20.0,
            "is_express": false
          },
          "expected": {
            "shipping_cost": 3.50
          }
        },
        {
          "step_number": 5,
          "action": "calculate_total",
          "expected": {
            "subtotal": 80.00,
            "discount": 8.00,
            "tax": 5.76,
            "shipping": 3.50,
            "total": 81.26
          }
        },
        {
          "step_number": 6,
          "action": "process_payment",
          "expected": {
            "status": "success",
            "amount_charged": 81.26
          }
        }
      ]
    },
