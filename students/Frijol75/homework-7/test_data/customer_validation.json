    "test_name": "multiple_errors_all_card_fields_invalid",
    "customer": {
      "email": "valid@example.com",
      "phone": "(555) 123-4567",
      "billing_address": {"street": "123 Main St", "city": "New York", "state": "NY", "zip": "10001"},
      "credit_card": {"number": "1111", "expiration": "99/9999", "cvv": "1"}
