  {
    "test_name": "multiple_errors_all_address_fields_missing_or_invalid",
    "customer": {
      "email": "valid@example.com",
      "phone": "(555) 123-4567",
      "billing_address": {"street": "", "city": "", "state": "INVALID", "zip": "0"},
      "credit_card": {"number": "4532015112830366", "expiration": "12/2028", "cvv": "123"}
    },
    "expected": {
      "is_valid": false,
      "errors": ["Missing street", "Missing city", "Invalid state", "Invalid zip code"]
    }
  },
  {
    "test_name": "multiple_errors_every_section_fails",
    "customer": {
      "email": "bademail",
      "phone": "999",
      "billing_address": {"street": "", "city": "", "state": "XX", "zip": "00"},
      "credit_card": {"number": "0000", "expiration": "00/0000", "cvv": "0"}
    },
    "expected": {
      "is_valid": false,
      "errors": [
        "Invalid email format",
        "Invalid phone format",
        "Missing street",
        "Missing city",
        "Invalid state",
        "Invalid zip code",
        "Invalid credit card number",
        "Invalid expiration format",
        "Invalid CVV"
      ]
    }
