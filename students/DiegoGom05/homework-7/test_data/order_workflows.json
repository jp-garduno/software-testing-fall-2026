        {
          "action": "create_order",
          "data": {
            "customer_type": "new",
            "items": [
              { "name": "Blender", "price": 45, "quantity": 1, "weight": 3 },
              { "name": "Cups", "price": 6, "quantity": 4, "weight": 0.25 }
