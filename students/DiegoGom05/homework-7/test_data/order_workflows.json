        }
      ]
    },
    {
      "name": "invalid_customer_payment_rejected",
      "description": "Email invalido y tarjeta vencida: la orden se calcula pero el pago se rechaza",
      "steps": [
        {
          "action": "validate_customer",
          "data": {
            "customer": {
              "email": "not-an-email",
              "phone": "(555) 123-4567",
              "billing_address": {
                "street": "9 Elm St",
                "city": "Chicago",
                "state": "IL",
                "zip": "60601"
              },
              "credit_card": {
                "number": "4111111111111111",
                "expiration": "01/2020",
                "cvv": "321"
              }
            }
          },
          "expected": {
            "valid": false,
            "errors": ["Invalid email format", "Credit card expired"]
          }
        },
        {
          "action": "create_order",
          "data": {
            "customer_type": "regular",
            "items": [
              { "name": "Book", "price": 30, "quantity": 1, "weight": 1 }
            ]
          },
          "expected": { "status": "created" }
        },
        {
          "action": "set_shipping",
          "data": { "distance_km": 10, "is_express": false },
          "expected": { "status": "set" }
        },
        {
          "action": "calculate_total",
          "expected": {
            "subtotal": 30.0,
            "discount": 0.0,
            "tax": 2.4,
            "shipping": 1.5,
            "total": 33.9
          }
        },
        {
          "action": "process_payment",
          "expected": { "status": "failed", "reason": "Invalid customer" }
        }
      ]
    },
