{
  "workflows": [
    {
      "name": "complete_order_flow",
      "description": "Cliente regular valido, codigo SAVE10, envio estandar, pago exitoso",
      "steps": [
        {
          "action": "validate_customer",
          "data": {
            "customer": {
              "email": "john@example.com",
              "phone": "(555) 123-4567",
              "billing_address": {
                "street": "123 Main St",
                "city": "New York",
                "state": "NY",
                "zip": "10001"
              },
              "credit_card": {
                "number": "4532015112830366",
                "expiration": "12/2030",
                "cvv": "123"
              }
            }
          },
          "expected": { "valid": true, "errors": [] }
        },
        {
          "action": "create_order",
          "data": {
            "customer_type": "regular",
            "items": [
              { "name": "Laptop", "price": 80, "quantity": 1, "weight": 2 },
              { "name": "Mouse", "price": 15, "quantity": 2, "weight": 0.2 }
            ]
          },
          "expected": { "status": "created" }
        },
        {
          "action": "apply_discount",
          "data": { "code": "SAVE10" },
          "expected": { "applied": true }
        },
        {
          "action": "set_shipping",
          "data": { "distance_km": 25, "is_express": false },
          "expected": { "status": "set" }
        },
        {
          "action": "calculate_total",
          "expected": {
            "subtotal": 110.0,
            "discount": 11.0,
            "tax": 7.92,
            "shipping": 3.7,
            "total": 110.62
          }
        },
        {
          "action": "process_payment",
          "expected": { "status": "success", "amount": 110.62 }
        }
      ]
    },
    {
