{
  "workflows": [
    {
      "name": "standard_order",
      "steps": [
        {
          "action": "validate_customer",
          "data": {
            "email": "john@example.com",
            "phone": "(555) 123-4567",
            "billing_address": {
              "street": "123 Main St",
              "city": "New York",
              "state": "NY",
              "zip": "10001"
            },
            "credit_card": {
              "number": "4532015112830366",
              "expiration": "12/2030",
              "cvv": "123"
            }
          },
          "expected": {
            "valid": true
          }
        },
        {
          "action": "create_order",
          "data": {
            "items": [
              {
                "name": "Item",
                "price": 100,
                "quantity": 1,
                "weight": 2
              }
            ],
            "customer_type": "regular",
            "discount_code": "NONE",
            "distance_km": 10,
            "is_express": false
          },
          "expected": {
            "status": "created"
          }
        },
        {
          "action": "calculate_total",
          "expected": {
            "total": 110
          }
        },
        {
          "action": "process_payment",
          "expected": {
            "status": "success"
          }
        },
        {
          "action": "confirm_order",
          "expected": {
            "status": "confirmed",
            "total": 110
          }
        }
      ]
    },
