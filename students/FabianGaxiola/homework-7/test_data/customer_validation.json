[
  {
    "test_name": "valid_customer_primary",
    "customer": {
      "email": "alex@example.com",
      "phone": "(555) 123-4567",
      "billing_address": {
        "street": "123 Main St",
        "city": "New York",
        "state": "NY",
        "zip": "10001"
      },
      "credit_card": {
        "number": "4532015112830366",
        "expiration": "12/2030",
        "cvv": "123"
      }
    },
    "expected": { "is_valid": true, "errors": [] }
  },
