          "expected": {
            "status": "shipping_set"
          }
        },
        {
          "action": "calculate_total",
          "expected": {
            "subtotal": 30.0,
            "discount": 0.0,
            "tax": 2.4,
            "shipping": 0.5,
            "total": 32.9
          }
        },
        {
          "action": "process_payment",
          "expected": {
            "status": "success",
            "amount": 32.9
          }
        },
        {
          "action": "generate_confirmation",
          "expected": {
            "status": "confirmed",
            "confirmation_number": "ORD-000001"
          }
        }
      ]
    }
  ]
