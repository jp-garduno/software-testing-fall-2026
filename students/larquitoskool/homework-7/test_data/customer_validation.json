  { "test_name": "invalid_cc_expired_month", "customer": { "email": "a@b.com", "phone": "(555) 123-4567", "billing_address": { "street": "1", "city": "C", "state": "S", "zip": "1" }, "credit_card": { "number": "4532015112830366", "expiration": "01/2024" } }, "expected": { "is_valid": false, "errors": ["Credit card expired or invalid date"] } },
  { "test_name": "invalid_cc_bad_format_date", "customer": { "email": "a@b.com", "phone": "(555) 123-4567", "billing_address": { "street": "1", "city": "C", "state": "S", "zip": "1" }, "credit_card": { "number": "4532015112830366", "expiration": "12-2025" } }, "expected": { "is_valid": false, "errors": ["Credit card expired or invalid date"] } },
  { "test_name": "invalid_cc_impossible_month", "customer": { "email": "a@b.com", "phone": "(555) 123-4567", "billing_address": { "street": "1", "city": "C", "state": "S", "zip": "1" }, "credit_card": { "number": "4532015112830366", "expiration": "13/2025" } }, "expected": { "is_valid": false, "errors": ["Credit card expired or invalid date"] } },
  { "test_name": "invalid_cc_missing_object", "customer": { "email": "a@b.com", "phone": "(555) 123-4567", "billing_address": { "street": "1", "city": "C", "state": "S", "zip": "1" } }, "expected": { "is_valid": false, "errors": ["Invalid credit card number", "Credit card expired or invalid date"] } },

  { "test_name": "multiple_email_and_phone", "customer": { "email": "bademail", "phone": "123", "billing_address": { "street": "1", "city": "C", "state": "S", "zip": "1" }, "credit_card": { "number": "4532015112830366", "expiration": "12/2025" } }, "expected": { "is_valid": false, "errors": ["Invalid email format", "Invalid phone format"] } },
  { "test_name": "multiple_address_and_cc", "customer": { "email": "a@b.com", "phone": "(555) 123-4567", "billing_address": { "street": "1" }, "credit_card": { "number": "123", "expiration": "12/2025" } }, "expected": { "is_valid": false, "errors": ["Invalid billing address", "Invalid credit card number"] } },
  { "test_name": "multiple_cc_num_and_exp", "customer": { "email": "a@b.com", "phone": "(555) 123-4567", "billing_address": { "street": "1", "city": "C", "state": "S", "zip": "1" }, "credit_card": { "number": "abc", "expiration": "past" } }, "expected": { "is_valid": false, "errors": ["Invalid credit card number", "Credit card expired or invalid date"] } },
  { "test_name": "multiple_phone_and_address", "customer": { "email": "a@b.com", "phone": "(555) 1234567", "billing_address": { "city": "C" }, "credit_card": { "number": "4532015112830366", "expiration": "12/2025" } }, "expected": { "is_valid": false, "errors": ["Invalid phone format", "Invalid billing address"] } },
  { "test_name": "multiple_email_address_cc", "customer": { "email": "a@b", "phone": "(555) 123-4567", "billing_address": {}, "credit_card": { "number": "123", "expiration": "12/2025" } }, "expected": { "is_valid": false, "errors": ["Invalid email format", "Invalid billing address", "Invalid credit card number"] } },
  { "test_name": "multiple_all_wrong", "customer": { "email": "bad", "phone": "bad", "billing_address": {}, "credit_card": {} }, "expected": { "is_valid": false, "errors": ["Invalid email format", "Invalid phone format", "Invalid billing address", "Invalid credit card number", "Credit card expired or invalid date"] } }
