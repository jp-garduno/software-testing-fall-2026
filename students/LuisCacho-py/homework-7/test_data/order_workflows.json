{
  "workflows": [
    {
      "name": "complete_order_flow",
      "steps": [
        {
          "action": "validate_customer",
          "data": {
            "email": "john@example.com",
            "phone": "(555) 123-4567",
            "billing_address": {
              "street": "123 Main St",
              "city": "New York",
              "state": "NY",
              "zip": "10001"
            },
            "credit_card": {
              "number": "4532015112830366",
              "expiration": "12/2026",
              "cvv": "123"
            }
          },
          "expected": {
            "valid": true
          }
        },
        {
          "action": "create_order",
          "data": {
            "items": [
              {
                "name": "Laptop Stand",
                "price": 100.0,
                "quantity": 1,
                "weight": 2.0
              }
            ],
            "customer_type": "regular",
            "discount_code": "NONE",
            "distance_km": 165.0,
            "is_express": false
          },
          "expected": {
            "status": "created"
          }
        },
        {
          "action": "calculate_total",
          "expected": {
            "subtotal": 100.0,
            "discount": 0.0,
            "tax": 8.0,
            "shipping": 17.5,
            "total": 125.5
          }
        },
        {
          "action": "process_payment",
          "expected": {
            "status": "success"
          }
        }
      ]
    },
