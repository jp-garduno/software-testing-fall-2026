{
  "reference_date": "2026-11-10",
  "workflows": [
    {
      "name": "regular_order_standard_shipping",
      "order_id": "HW7-001",
      "steps": [
        {
          "action": "validate_customer",
          "data": {
            "customer": {
              "email": "alex@example.com",
              "phone": "(212) 555-0123",
              "billing_address": {
                "street": "123 Main St",
                "city": "New York",
                "state": "NY",
                "zip": "10001"
              },
              "credit_card": {
                "number": "4242424242424242",
                "expiration": "12/2028",
                "cvv": "123"
              }
            }
          },
          "expected": {
            "valid": true,
            "errors": []
          }
        },
        {
          "action": "create_order",
          "data": {
            "items": [
              {
                "name": "Item1",
                "price": 50,
                "quantity": 1,
                "weight": 1
              }
            ],
            "shipping": {
              "distance_km": 10,
              "is_express": false
            }
          },
          "expected": {
            "status": "created",
            "discount_applied": false
          }
        },
        {
          "action": "calculate_total",
          "expected": {
            "subtotal": 50,
            "discount": 0,
            "tax": 4,
            "shipping": 1.5,
            "total": 55.5
          }
        },
        {
          "action": "process_payment",
          "expected": {
            "status": "success",
            "amount": 55.5
          }
        },
        {
          "action": "confirm_order",
          "expected": {
            "status": "confirmed",
            "order_id": "HW7-001",
            "total": 55.5
          }
        }
      ]
    },
