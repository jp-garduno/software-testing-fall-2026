    {
      "name": "free_express_shipping_and_payment_retry",
      "order_id": "HW7-003",
      "steps": [
        {
          "action": "validate_customer",
          "data": {
            "customer": {
              "email": "alex@example.com",
              "phone": "(212) 555-0123",
              "billing_address": {
                "street": "123 Main St",
                "city": "New York",
                "state": "NY",
                "zip": "10001"
              },
              "credit_card": {
                "number": "4242424242424242",
                "expiration": "12/2028",
                "cvv": "123"
              }
            }
          },
          "expected": {
            "valid": true,
            "errors": []
          }
        },
        {
          "action": "create_order",
          "data": {
            "items": [
              {
                "name": "Desk lamp",
                "price": 80,
                "quantity": 1,
                "weight": 8
              }
            ],
            "discount_code": "FREESHIP",
            "shipping": {
              "distance_km": 40,
              "is_express": true
            }
          },
          "expected": {
            "status": "created",
            "discount_applied": true
          }
        },
        {
          "action": "calculate_total",
          "expected": {
            "subtotal": 80,
            "discount": 0,
            "tax": 6.4,
            "shipping": 0,
            "total": 86.4
          }
        },
        {
          "action": "process_payment",
          "data": {
            "approved": false
          },
          "expected": {
            "status": "declined"
          }
        },
        {
          "action": "confirm_order",
          "expected_error": "confirm_order is not allowed in state payment_declined"
        },
        {
          "action": "process_payment",
          "expected": {
            "status": "success",
            "amount": 86.4
          }
        },
        {
          "action": "confirm_order",
          "expected": {
            "status": "confirmed",
            "order_id": "HW7-003",
            "total": 86.4
          }
        },
        {
          "action": "process_payment",
          "expected_error": "process_payment is not allowed in state confirmed"
        }
      ]
    },
    {
      "name": "invalid_customer_blocks_checkout",
      "order_id": "HW7-004",
      "steps": [
        {
          "action": "validate_customer",
          "data": {
            "customer": {
              "email": "invalid-email",
              "phone": "(212) 555-0123",
              "billing_address": {
                "street": "123 Main St",
                "city": "New York",
                "state": "NY",
                "zip": "10001"
              },
              "credit_card": {
                "number": "4242424242424243",
                "expiration": "12/2028",
                "cvv": "123"
              }
            }
          },
          "expected": {
            "valid": false,
            "errors": [
              "Invalid email format",
              "Invalid credit card number"
            ]
          }
        },
        {
          "action": "create_order",
          "data": {
            "items": [
              {
                "name": "Item1",
                "price": 50,
                "quantity": 1,
                "weight": 1
              }
            ],
            "shipping": {
              "distance_km": 10,
              "is_express": false
            }
          },
          "expected_error": "create_order is not allowed in state customer_rejected"
        },
        {
          "action": "process_payment",
          "expected_error": "process_payment is not allowed in state customer_rejected"
        }
      ]
    },
