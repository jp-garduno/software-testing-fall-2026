{
  "root": true,
  "env": { "node": true, "es2022": true, "jest": true },
  "parserOptions": { "ecmaVersion": "latest", "sourceType": "script" },
  "extends": "eslint:recommended",
  "rules": {
    "eqeqeq": "error",
    "no-var": "error",
    "prefer-const": "error",
    "no-param-reassign": "error",
    "max-len": ["error", { "code": 120, "ignoreUrls": true }]
  }
}
