{
  "name": "homework-4-secure-bank-black-box-tests",
  "version": "1.0.0",
  "description": "Black box test suite (EP, BVA, decision tables, state transitions) for the SecureBank system - JavaScript port",
  "private": true,
  "scripts": {
    "test": "jest --coverage",
    "lint": "eslint src tests jest.setup.js --ext .js"
  },
  "devDependencies": {
    "eslint": "^8.56.0",
    "jest": "^29.7.0"
  },
  "jest": {
    "testEnvironment": "node",
    "roots": ["<rootDir>/tests"],
    "testMatch": ["**/*.test.js"],
    "setupFiles": ["<rootDir>/jest.setup.js"],
    "collectCoverageFrom": ["src/**/*.js"],
    "coverageDirectory": "coverage",
    "coverageThreshold": {
      "global": { "branches": 80, "functions": 80, "lines": 80, "statements": 80 }
    }
  }
}
