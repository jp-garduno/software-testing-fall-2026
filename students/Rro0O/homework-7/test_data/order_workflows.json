{
  "reference_date": "2026-01-01",
  "workflows": [
    {
      "name": "complete_order_flow",
      "steps": [
        {
          "action": "validate_customer",
          "data": {
            "email": "john@example.com",
            "phone": "(555) 123-4567",
            "billing_address": {
              "street": "123 Main St",
              "city": "New York",
              "state": "NY",
              "zip": "10001"
            },
            "credit_card": {
              "number": "4532015112830366",
              "expiration": "12/2027",
              "cvv": "123"
            }
          },
          "expected": {
            "valid": true,
            "errors": []
          }
        },
        {
          "action": "create_order",
          "data": {
            "items": [
              {
                "name": "Widget",
                "price": 25.0,
                "quantity": 2,
                "weight": 1.5
              },
              {
                "name": "Gadget",
                "price": 40.0,
                "quantity": 1,
                "weight": 2.0
              }
            ],
            "customer_type": "regular"
          },
          "expected": {
            "status": "created",
            "item_count": 2
          }
        },
        {
          "action": "apply_discount",
          "data": {
            "code": "SAVE10"
          },
          "expected": {
            "applied": true
          }
        },
        {
          "action": "set_shipping",
          "data": {
            "distance_km": 100,
            "is_express": false
          },
          "expected": {
            "status": "set"
          }
        },
        {
          "action": "calculate_total",
          "expected": {
            "subtotal": 90.0,
            "discount": 9.0,
            "tax": 6.48,
            "shipping": 12.5,
            "total": 99.98
          }
        },
        {
          "action": "process_payment",
          "expected": {
            "status": "success",
            "charged": 99.98
          }
        },
        {
          "action": "confirm_order",
          "expected": {
            "status": "confirmed",
            "confirmation_id": "ORD-000001",
            "total": 99.98
          }
        }
      ]
    },
    {
      "name": "invalid_customer_blocks_order",
      "steps": [
        {
          "action": "validate_customer",
          "data": {
            "email": "not-an-email",
            "phone": "(555) 123-4567",
            "billing_address": {
              "street": "123 Main St",
              "city": "New York",
              "state": "NY",
              "zip": "10001"
            },
            "credit_card": {
              "number": "4532015112830366",
              "expiration": "12/2027",
              "cvv": "123"
            }
          },
          "expected": {
            "valid": false,
            "errors": [
              "Invalid email format"
            ]
          }
        },
        {
          "action": "create_order",
          "data": {
            "items": [
              {
                "name": "Widget",
                "price": 25.0,
                "quantity": 1,
                "weight": 1
              }
            ]
          },
          "expected": {
            "status": "rejected",
            "reason": "invalid customer"
          }
        },
        {
          "action": "calculate_total",
          "expected": {
            "status": "rejected",
            "reason": "no order"
          }
        },
        {
          "action": "process_payment",
          "expected": {
            "status": "failed",
            "reason": "total not calculated"
          }
        },
        {
          "action": "confirm_order",
          "expected": {
            "status": "rejected",
            "reason": "payment required"
          }
        }
      ]
    },
