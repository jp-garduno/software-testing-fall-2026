  {
    "test_name": "valid_customer_all_fields",
    "customer": {
      "email": "john@example.com",
      "phone": "(555) 123-4567",
      "billing_address": {
        "street": "123 Main St",
        "city": "New York",
        "state": "NY",
        "zip": "10001"
      },
      "credit_card": {
        "number": "4532015112830366",
        "expiration": "12/2027",
        "cvv": "123"
      }
    },
    "expected": {
      "is_valid": true,
      "errors": []
    }
  },
