{
  "reference_date": "2025-01-15",
  "workflows": [
    {
      "name": "complete_order_flow",
      "description": "Valid customer, SAVE10, standard shipping, successful payment and confirmation.",
      "steps": [
        {
          "action": "validate_customer",
          "data": {
            "email": "john@example.com",
            "phone": "(555) 123-4567",
            "billing_address": {
              "street": "123 Main St",
              "city": "New York",
              "state": "NY",
              "zip": "10001"
            },
            "credit_card": {
              "number": "4532015112830366",
              "expiration": "12/2025",
              "cvv": "123"
            }
          },
          "expected": {
            "valid": true,
            "errors": []
          }
        },
        {
          "action": "create_order",
          "data": {
            "customer_type": "regular",
            "items": [
              {
                "name": "Widget",
                "price": 40,
                "quantity": 2,
                "weight": 1.5
              },
              {
                "name": "Gadget",
                "price": 45,
                "quantity": 1,
                "weight": 2
              }
            ]
          },
          "expected": {
            "status": "created",
            "item_count": 2
          }
        },
        {
          "action": "apply_discount",
          "data": {
            "code": "SAVE10"
          },
          "expected": {
            "applied": true
          }
        },
        {
          "action": "set_shipping",
          "data": {
            "distance_km": 25,
            "is_express": false
          },
          "expected": {
            "status": "set"
          }
        },
        {
          "action": "calculate_total",
          "expected": {
            "subtotal": 125.0,
            "discount": 12.5,
            "tax": 9.0,
            "shipping": 5.0,
            "total": 126.5
          }
        },
        {
          "action": "process_payment",
          "expected": {
            "status": "success",
            "amount": 126.5
          }
        },
        {
          "action": "generate_confirmation",
          "expected": {
            "status": "confirmed",
            "total": 126.5
          }
        }
      ]
    },
    {
      "name": "invalid_customer_blocks_order",
      "description": "An invalid email stops the flow: no order, no payment.",
      "steps": [
        {
          "action": "validate_customer",
          "data": {
            "email": "not-an-email",
            "phone": "(555) 123-4567",
            "billing_address": {
              "street": "123 Main St",
              "city": "New York",
              "state": "NY",
              "zip": "10001"
            },
            "credit_card": {
              "number": "4532015112830366",
              "expiration": "12/2025",
              "cvv": "123"
            }
          },
          "expected": {
            "valid": false,
            "errors": [
              "Invalid email format"
            ]
          }
        },
        {
          "action": "create_order",
          "data": {
            "customer_type": "regular",
            "items": [
              {
                "name": "Widget",
                "price": 40,
                "quantity": 1,
                "weight": 1
              }
            ]
          },
          "expected": {
            "status": "rejected",
            "reason": "customer not validated"
          }
        },
        {
          "action": "process_payment",
          "expected": {
            "status": "rejected",
            "reason": "no active order"
          }
        }
      ]
    },
    {
      "name": "high_value_order_payment_declined",
      "description": "Total above the payment limit is declined and cannot be confirmed.",
