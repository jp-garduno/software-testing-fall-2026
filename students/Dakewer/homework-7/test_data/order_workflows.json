              "cvv": "123"
            }
          },
          "expected": {
            "valid": true
          }
        },
        {
          "action": "create_order",
          "data": {
            "customer_type": "regular",
            "items": [
              {
                "name": "Diamond",
                "price": 6000,
                "quantity": 2,
                "weight": 0.1
              }
            ]
          },
          "expected": {
            "status": "created"
          }
        },
        {
          "action": "set_shipping",
          "data": {
            "distance_km": 100,
            "is_express": true
          },
          "expected": {
            "status": "set"
          }
        },
        {
          "action": "calculate_total",
          "expected": {
            "subtotal": 12000.0,
            "tax": 960.0,
            "shipping": 15.15,
            "total": 12975.15
          }
        },
        {
          "action": "process_payment",
          "expected": {
            "status": "declined",
            "reason": "amount exceeds limit"
          }
        },
        {
          "action": "generate_confirmation",
          "expected": {
            "status": "rejected",
            "reason": "payment not completed"
          }
        }
      ]
    },
