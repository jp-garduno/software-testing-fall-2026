{
  "name": "flujo-git",
  "version": "1.0.0",
  "description": "Tarea 01: Proyecto de flujo de Trabajo con Git",
  "main": "dist/app.js",
  "scripts": {
    "test": "nodemon src/app.ts",
    "start": "npm run build && node .",
    "build": "npm run clean && tsc && npm run copy",
    "clean": "rimraf dist",
    "dev": "nodemon src/app.ts",
    "copy": "copyfiles -u 1 \"src/views/**/*.handlebars\" dist"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Necross12/git-workflow-practice.git"
  },
  "keywords": [
    "tarea",
    "pruebas",
    "git"
  ],
  "author": "Diego Orozco",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/Necross12/git-workflow-practice/issues"
  },
  "homepage": "https://github.com/Necross12/git-workflow-practice#readme",
  "dependencies": {
    "copyfiles": "^2.4.1",
    "express": "^5.2.1",
    "express-handlebars": "^8.0.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^25.5.0",
    "dotenv": "^17.4.2",
    "nodemon": "^3.1.14",
    "rimraf": "^6.1.3",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}