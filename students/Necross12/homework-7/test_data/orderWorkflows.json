{
  "workflows": [
    {
      "name": "pedido completo con SAVE20 y envio estandar",
      "steps": [
        {
          "action": "validate_customer",
          "data": {
            "email": "john@example.com",
            "phone": "(555) 123-4567",
            "billing_address": {
              "street": "123 Main St",
              "city": "New York",
              "state": "NY",
              "zip": "10001"
            },
            "credit_card": {
              "number": "4532015112830366",
              "expiration": "12/2030",
              "cvv": "123"
            }
          },
          "expected": { "valid": true, "errors": [] }
        },
        {
          "action": "create_order",
          "data": {
            "items": [
              { "name": "Laptop Stand", "price": 40, "quantity": 2, "weight": 1.5 },
              { "name": "Mouse", "price": 25, "quantity": 1, "weight": 0.5 }
            ],
            "customer_type": "regular",
            "discount_code": "SAVE20",
            "distance_km": 20,
            "is_express": false
          },
          "expected": { "status": "created" }
        },
        {
          "action": "calculate_total",
          "expected": {
            "subtotal": 105.0,
            "discount": 21.0,
            "tax": 6.72,
            "shipping": 3.75,
            "total": 94.47
          }
        },
        {
          "action": "process_payment",
          "expected": { "status": "success", "amount": 94.47 }
        }
      ]
    },
    {
      "name": "cliente nuevo con NEWUSER y envio expres",
      "steps": [
        {
          "action": "validate_customer",
          "data": {
            "email": "maria@example.com",
            "phone": "(555) 987-6543",
            "billing_address": {
              "street": "45 Oak Ave",
              "city": "Austin",
              "state": "TX",
              "zip": "73301-1234"
            },
            "credit_card": {
              "number": "4111111111111111",
              "expiration": "12/2030",
              "cvv": "123"
            }
          },
          "expected": { "valid": true, "errors": [] }
        },
        {
          "action": "create_order",
          "data": {
            "items": [
              { "name": "Book", "price": 30, "quantity": 2, "weight": 0.4 }
            ],
            "customer_type": "new",
            "discount_code": "NEWUSER",
            "distance_km": 50,
            "is_express": true
          },
          "expected": { "status": "created" }
        },
        {
          "action": "calculate_total",
          "expected": {
            "subtotal": 60.0,
            "discount": 9.0,
            "tax": 4.08,
            "shipping": 8.1,
            "total": 63.18
          }
        },
        {
          "action": "process_payment",
          "expected": { "status": "success", "amount": 63.18 }
        }
      ]
    },
    {
