    },
    {
      "name": "(invalida) cliente con email y CVV invalidos",
      "steps": [
        {
          "action": "validate_customer",
          "data": {
            "email": "invalid-email",
            "phone": "(555) 123-4567",
            "billing_address": {
              "street": "123 Main St",
              "city": "New York",
              "state": "NY",
              "zip": "10001"
            },
            "credit_card": {
              "number": "4532015112830366",
              "expiration": "12/2030",
              "cvv": "12"
            }
          },
          "expected": {
            "valid": false,
            "errors": ["Formato de correo electrónico inválido", "CVV inválido"]
          }
        },
        {
          "action": "create_order",
          "data": {
            "items": [
              { "name": "Item1", "price": 50, "quantity": 1, "weight": 1 }
            ],
            "customer_type": "regular",
            "discount_code": null,
            "distance_km": 10,
            "is_express": false
          },
          "expected": { "status": "rejected" }
        },
        {
          "action": "process_payment",
          "expected": { "status": "not_processed" }
        }
      ]
    },
    {
      "name": "(invalida) pedido con precio negativo",
      "steps": [
        {
          "action": "validate_customer",
          "data": {
            "email": "john@example.com",
            "phone": "(555) 123-4567",
            "billing_address": {
              "street": "123 Main St",
              "city": "New York",
              "state": "NY",
              "zip": "10001"
            },
            "credit_card": {
              "number": "4532015112830366",
              "expiration": "12/2030",
              "cvv": "123"
            }
          },
          "expected": { "valid": true, "errors": [] }
        },
        {
          "action": "create_order",
          "data": {
            "items": [
              { "name": "Item1", "price": -10, "quantity": 1, "weight": 1 }
            ],
            "customer_type": "regular",
            "discount_code": null,
            "distance_km": 10,
            "is_express": false
          },
          "expected": { "status": "created" }
        },
        {
          "action": "calculate_total",
          "expected": { "error": "El precio y la cantidad no deben ser negativos" }
        },
        {
          "action": "process_payment",
          "expected": { "status": "not_processed" }
        }
      ]
    }
  ]
