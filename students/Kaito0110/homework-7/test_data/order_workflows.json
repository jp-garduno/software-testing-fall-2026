{
  "workflows": [
    {
      "name": "complete_standard_order_flow",
      "steps": [
        {
          "action": "validate_customer",
          "data": {
            "email": "john@example.com",
            "phone": "(555) 123-4567",
            "billing_address": {
              "street": "123 Main St",
              "city": "New York",
              "state": "NY",
              "zip": "10001"
            },
            "credit_card": {
              "number": "4532015112830366",
              "expiration": "12/2027",
              "cvv": "123"
            }
          },
          "expected": {
            "valid": true
          }
        },
        {
          "action": "create_order",
          "data": {
            "items": [
              {
                "name": "Wireless Keyboard",
                "price": 100.0,
                "quantity": 1,
                "weight": 2.0
              }
            ],
            "customer_type": "regular",
            "discount_code": "SAVE20",
            "distance_km": 20.0,
            "is_express": false
          },
          "expected": {
            "status": "created"
          }
        },
        {
          "action": "calculate_total",
          "expected": {
            "subtotal": 100.0,
            "discount": 20.0,
            "tax": 6.4,
            "shipping": 3.0,
            "total": 89.4
          }
        },
        {
          "action": "process_payment",
          "expected": {
            "status": "success"
          }
        }
      ]
    },
