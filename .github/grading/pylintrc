# Pylint configuration used by the automated grading workflow.
#
# Submissions used to be graded with pylint's defaults, which are stricter than
# the standards this course actually teaches: pylint wraps at 100 columns while
# CLAUDE.md, module 3 and exam 1 all state 120, and it asks for a docstring on
# every module, class and function even though every homework rubric already
# grades documentation by reading the submission.
#
# A submission that ships its own pylint configuration is graded with that one
# instead of this file: homework 3 asks students to write one, and exam 1 lets
# them set the line length themselves. See the "Check code quality" step in
# .github/workflows/grading-automation.yml.

[MAIN]
# Every graded run is a fresh checkout, so there is no previous score to carry.
persistent = no

[FORMAT]
# The course standard. Pylint's own default is 100.
max-line-length = 120

[MESSAGES CONTROL]
# Each entry is either something the student cannot act on from here, or
# something a human already grades elsewhere in the rubric:
#
#   import-error, no-name-in-module
#     The runner does not install a submission's dependencies and does not know
#     its import layout, so `from banking_system import ...` in the src/ +
#     tests/ layout the course recommends is unresolvable on the runner. Pylint
#     weighs an error five times a convention, so this would cost more than a
#     real defect.
#   missing-module-docstring, missing-class-docstring,
#   missing-function-docstring
#     Documentation is a rubric item scored by reading the submission (homework
#     4, part 5, and its equivalent in the others). Charging it here too counts
#     it twice, and it counted heavily: docstrings were 18 of the 27 findings on
#     PR #143. The course still asks for docstrings on public functions
#     (.claude/CLAUDE.md) - that requirement is now graded by a human only.
#     This is also why there is no no-docstring-rgx here: with all three
#     messages off, the exemption pattern would have nothing left to exempt.
#   duplicate-code
#     Boundary-value and parameterized tests repeat themselves on purpose.
#   too-few-public-methods
#     Fires on the small classes students use to group a handful of test cases.
disable =
    import-error,
    no-name-in-module,
    missing-module-docstring,
    missing-class-docstring,
    missing-function-docstring,
    duplicate-code,
    too-few-public-methods
